# ===== Backend environment =====
# Copy this file to ".env" and fill in real values for local development.
# On Render/Railway, set these in the dashboard's Environment settings instead.

# ---- Required: provider API keys ----
DEEPGRAM_API_KEY=          # Speech-to-text + text-to-speech (https://console.deepgram.com)
GROQ_API_KEY=              # LLM inference (https://console.groq.com)
TAVILY_API_KEY=            # Web search (https://app.tavily.com)

# ---- Server ----
# PORT is injected automatically by Render/Railway/Heroku. Leave unset there.
# Locally it defaults to 8080 if omitted.
PORT=8080
# HOST defaults to 0.0.0.0 (required for cloud platforms). Rarely needs changing.
# HOST=0.0.0.0

# ---- Security ----
# Comma-separated list of browser origins allowed to connect (HTTP + WebSocket).
# Use your deployed frontend URL in production, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000
# "*" allows any origin and is intended for local development ONLY.
ALLOWED_ORIGINS=*

# Shared secret that protects POST /admin/context. If unset, the admin API is disabled.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# ---- Optional: keep-alive ----
# Set to the public /health URL to self-ping and prevent free-tier idle spin-down.
# Example: https://your-backend.onrender.com/health
SELF_PING_URL=
