# ===== Frontend environment =====
# Copy to ".env.local" for local development.
# On Vercel, set this in Project Settings -> Environment Variables instead.

# WebSocket URL of the backend voice server.
#   Local dev:  ws://localhost:8080
#   Production: wss://your-backend.onrender.com   (must be wss:// over HTTPS)
NEXT_PUBLIC_WS_URL=ws://localhost:8080
